\# Imagem oficial do Node.js FROM node:18-alpine # Define o diretório de trabalho no container WORKDIR /app # Copia os arquivos de dependência COPY package\*.json ./ # Instala apenas as dependências de produção RUN npm install --production # Copia todo o código-fonte da aplicação COPY . . # Expõe a porta do servidor EXPOSE 3000 # Variáveis de ambiente padrão ENV PORT=3000 ENV JWT\_SECRET=zentix\_chave\_secreta\_jwt\_2026 # Comando para iniciar a API CMD ["npm", "start"]